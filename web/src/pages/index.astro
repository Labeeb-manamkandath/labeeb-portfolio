---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Experiences from "../components/Experiences.astro";
import ProjectGrid from "../components/ProjectGrid.astro";
import Contact from "../components/Contact.astro";
import { ROLES } from "../data/profile.js";

// What a team gets. Each point comes from Labeeb's own About page and roles, rewritten to scan.
const strengths = [
  { t: "End-to-end UI/UX design", d: "From research and user flows to information architecture, high-fidelity UI and developer handoff, across mobile and web." },
  { t: "AI that's simple to use", d: "I take what a model can do and make it simple enough to use and clear enough to trust, for people with no time to learn a new tool." },
  { t: "Close work with engineering", d: "I work day to day with the UX head, stakeholders and developers. A degree in IT means I can talk honestly about what a design costs to build." },
  { t: "A graphic designer's eye", d: "Three years of brand and campaign work gave me strong habits in typography, layout and visual consistency." },
];
const tools = ["Figma", "Framer", "Adobe XD", "Photoshop", "Illustrator", "Microsoft Clarity", "Claude", "ChatGPT"];
---
<Base
  title="Labeeb Manamkandath · UI/UX Designer, AI experiences"
  description="Labeeb Manamkandath is a UI/UX Designer in Dubai with 5+ years of experience, designing field apps, web platforms and AI features that are live on construction sites."
>
  <Header current="home" />
  <main id="main">
    <Hero />

    <section class="sec" id="strengths" aria-labelledby="st-h">
      <div class="wrap">
        <div class="sec__head">
          <div class="sec__label reveal"><span class="sec-num">01</span><span class="mono">What I bring</span></div>
          <div class="sec__title reveal">
            <h2 id="st-h" class="h-lg">What I bring to a product team.</h2>
          </div>
        </div>
        <ol class="st">
          {strengths.map((s, i) => (
            <li class="reveal">
              <span class="mono st__n">{String(i + 1).padStart(2, "0")}</span>
              <h3 class="h-md">{s.t}</h3>
              <p>{s.d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <Experiences home />

    <section class="sec" id="work" aria-labelledby="wk-h">
      <div class="wrap">
        <div class="sec__head">
          <div class="sec__label reveal"><span class="sec-num">03</span><span class="mono">Selected work</span></div>
          <div class="sec__title reveal">
            <h2 id="wk-h" class="h-lg">Case studies, from AI features to apps and websites.</h2>
          </div>
        </div>
        <ProjectGrid only={["toolbox", "workforce", "zaper", "driver"]} />
        <p class="cs-link reveal"><a href="/projects">See all eight projects →</a></p>
      </div>
    </section>

    <section class="sec" id="background" aria-labelledby="bg-h">
      <div class="wrap">
        <div class="sec__head">
          <div class="sec__label reveal"><span class="sec-num">04</span><span class="mono">Background</span></div>
          <div class="sec__title reveal">
            <h2 id="bg-h" class="h-lg">Experience and tools.</h2>
          </div>
        </div>
        <div class="bg">
          <ol class="tl">
            {ROLES.map((r) => (
              <li class="reveal">
                <span class="mono tl__when">{r.when}</span>
                <div><h3>{r.role}</h3><span class="tl__co">{r.co}</span><p>{r.short}</p></div>
              </li>
            ))}
          </ol>
          <aside class="bg__side reveal">
            <h3 class="mono">Tools I use</h3>
            <ul class="chips">{tools.map((t) => <li>{t}</li>)}</ul>
            <div class="bg__links">
              <a class="btn btn--ghost" href="/about">More about me <span class="arr">→</span></a>
            </div>
          </aside>
        </div>
      </div>
    </section>
  </main>
  <Contact />
</Base>

<script is:inline>
  // The AI demos used to live on the homepage. Send old links like /#voice to their new home.
  (function () {
    var h = location.hash.slice(1);
    if (["demos", "voice", "face", "workforce", "talk"].indexOf(h) > -1) location.replace("/ai-work" + (h === "demos" ? "" : "#" + h));
  })();
</script>

<style>
  .st { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(12px, 1.6vw, 20px); }
  .st li { display: flex; flex-direction: column; gap: 10px; padding: 22px 20px 24px; background: var(--card); border: 1px solid var(--rule); border-radius: 16px; }
  .st__n { color: var(--tomato); font-size: 13px; }
  .st h3 { margin: 4px 0 0; }
  .st p { margin: 0; color: var(--fg-2); font-size: 15.5px; }

  .bg { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: clamp(28px, 5vw, 80px); align-items: start; }
  .tl { list-style: none; margin: 0; padding: 0; border-top: 1.5px solid var(--ink); }
  .tl li { display: grid; grid-template-columns: 160px minmax(0, 1fr); gap: 20px; padding: 20px 0; border-bottom: 1px solid var(--rule-strong); }
  .tl__when { color: var(--fg-3); padding-top: 4px; }
  .tl h3 { margin: 0; font-size: 20px; font-weight: 650; letter-spacing: -0.015em; }
  .tl__co { display: block; color: var(--tomato); font-size: 15px; margin: 4px 0 6px; }
  .tl p { margin: 0; color: var(--fg-2); font-size: 15.5px; }
  .bg__side { padding: 22px; border-radius: 16px; background: var(--card); border: 1px solid var(--rule); }
  .bg__side h3 { margin: 0 0 14px; font-size: 11.5px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--fg-3); font-weight: 500; }
  .chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .chips li { padding: 7px 12px; border: 1px solid var(--rule-strong); border-radius: 999px; font-size: 14.5px; font-weight: 550; background: var(--paper); }
  .bg__links { margin-top: 22px; }

  @media (max-width: 1080px) { .st { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 860px) { .bg { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 560px) {
    .st { grid-template-columns: minmax(0, 1fr); }
    .tl li { grid-template-columns: minmax(0, 1fr); gap: 4px; }
  }
</style>
