---
const steps = [
  { id: "find", t: "Find your face" },
  { id: "fit", t: "Fit it in the oval" },
  { id: "hold", t: "Hold still" },
  { id: "blink", t: "Blink once" },
  { id: "done", t: "Registered" },
];
---
<section class="sec fd" id="face" aria-labelledby="fd-h">
  <div class="wrap">
    <div class="sec__head">
      <div class="sec__label reveal"><span class="sec-num">02</span><span class="mono">Face registration</span></div>
      <div class="sec__title reveal">
        <h2 id="fd-h" class="h-lg">Register a face in one go.</h2>
        <p class="lede">The camera gives one instruction at a time, and a blink shows it's a real person, not a photo.</p>
      </div>
    </div>

    <div class="fdev reveal" data-fd>
      <div class="fdev__cam">
        <div class="stage" data-stage>
          <video data-video playsinline muted aria-hidden="true"></video>
          <div class="sim" data-sim aria-hidden="true"><span class="sim__face"><i></i><i></i><b></b></span></div>
          <svg class="oval" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
            <defs><mask id="fd-m"><rect width="100" height="100" fill="#fff" /><ellipse cx="50" cy="48" rx="25" ry="34" fill="#000" /></mask></defs>
            <rect width="100" height="100" fill="rgba(21,21,19,0.62)" mask="url(#fd-m)" />
            <ellipse class="oval__ring" data-ring cx="50" cy="48" rx="25" ry="34" pathLength="100" />
          </svg>
          <div class="ok" aria-hidden="true"><span class="ok__pulse"></span><svg viewBox="0 0 52 52"><circle class="ok__c" cx="26" cy="26" r="25" /><path class="ok__k" d="M15 27.5l7.5 7.5L38 19" pathLength="1" /></svg></div>
          <p class="cue" data-cue role="status" aria-live="polite">Ready when you are</p>
          <div class="start" data-start>
            <button class="fbtn fbtn--go eager" data-cam>Use my camera</button>
            <button class="fbtn" data-demo>Watch it without a camera</button>
            <p class="mono start__note">The camera runs on your device. Nothing is uploaded or saved.</p>
          </div>
        </div>
      </div>

      <div class="fdev__side">
        <div class="fdev__tags" data-tags>
          <span class="tag tag--live">Live on your device · face + blink detection</span>
          <span class="tag tag--sim">Simulated · saving the face</span>
        </div>
        <ol class="fsteps">
          {steps.map((s, i) => (
            <li data-fstep={s.id}><span class="mono">0{i + 1}</span>{s.t}</li>
          ))}
        </ol>
        <div class="after" data-after hidden>
          <span class="mono">Next morning, at the gate</span>
          <div class="checkin">
            <b>Checked in · 06:58</b>
            <span>Face matched · inside the site geofence</span>
          </div>
          <p class="small">Overtime is worked out from these check-ins and goes to the supervisor and HR to approve. <span class="tag tag--sim">Simulated</span></p>
          <button class="fbtn" data-again>Try again</button>
        </div>
        <p class="small" data-err></p>
      </div>
    </div>

    <div class="notes fd__notes">
      <div class="nt reveal"><span class="hand">why one instruction at a time?</span><p>Three instructions at once is noise. The screen only asks for the next thing.</p></div>
      <div class="nt reveal"><span class="hand">why a blink?</span><p>Anyone can blink. A printed photo can't.</p></div>
      <div class="nt reveal"><span class="hand">what if it fails on site?</span><p>Supervisors can mark attendance by hand, so nobody loses a day's pay.</p></div>
    </div>

    <p class="cs-link reveal"><a href="/work/case">Face Registration case study <span aria-hidden="true">→</span></a></p>
  </div>
</section>

<script>
  const root = document.querySelector("[data-fd]");
  const $ = (s) => root.querySelector(s);
  const $$ = (s) => [...root.querySelectorAll(s)];
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const wait = (ms) => new Promise((r) => setTimeout(r, reduce ? 60 : ms));
  const ORDER = ["find", "fit", "hold", "blink", "done"];
  let stream = null, landmarker = null, raf = 0, run = 0;

  function step(id) {
    const i = ORDER.indexOf(id);
    $$("[data-fstep]").forEach((li) => {
      const j = ORDER.indexOf(li.dataset.fstep);
      li.classList.toggle("done", j < i || id === "done");
      li.classList.toggle("on", j === i && id !== "done");
    });
    $("[data-ring]").style.strokeDashoffset = String(100 - Math.max(0, i) * 25);
    $("[data-stage]").dataset.state = id;
  }
  const cue = (t) => { $("[data-cue]").textContent = t; };

  function stop() {
    cancelAnimationFrame(raf); ++run;
    stream?.getTracks().forEach((t) => t.stop()); stream = null;
  }

  function success(live) {
    stop();
    step("done"); cue("Done. You're registered.");
    $("[data-after]").hidden = false;
    if (!live) $("[data-tags]").innerHTML = '<span class="tag tag--sim">Simulated · no camera used</span>';
  }

  function reset() {
    stop();
    $("[data-start]").hidden = false; $("[data-after]").hidden = true; $("[data-err]").textContent = "";
    $("[data-stage]").classList.remove("live", "demo");
    $("[data-tags]").innerHTML = '<span class="tag tag--live">Live on your device · face + blink detection</span><span class="tag tag--sim">Simulated · saving the face</span>';
    step("none"); cue("Ready when you are");
    $$("[data-fstep]").forEach((li) => li.classList.remove("on", "done"));
    $("[data-ring]").style.strokeDashoffset = "100";
  }

  // Scripted run for people without a camera
  async function demo() {
    reset(); const me = ++run;
    $("[data-start]").hidden = true; $("[data-stage]").classList.add("demo");
    const script = [["find", "Looking for your face…", 900], ["fit", "Move a little closer", 1100], ["fit", "Centre your face", 900], ["hold", "Hold still", 1200], ["blink", "Now blink once", 1300]];
    for (const [id, t, ms] of script) { if (me !== run) return; step(id); cue(t); await wait(ms); }
    if (me === run) { $("[data-stage]").classList.add("blinked"); await wait(500); success(false); $("[data-stage]").classList.remove("blinked"); }
  }

  // Real run: MediaPipe Face Landmarker, self-hosted and loaded only when asked
  async function live() {
    reset(); const me = ++run;
    $("[data-start]").hidden = true;
    cue("Starting the camera…");
    try {
      stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: "user", width: 640, height: 480 }, audio: false });
    } catch {
      $("[data-start]").hidden = false;
      $("[data-err]").textContent = "Couldn't open a camera. Allow it in your browser, or watch it without a camera.";
      cue("No camera"); return;
    }
    const video = $("[data-video]");
    video.srcObject = stream; await video.play();
    $("[data-stage]").classList.add("live");
    cue("Loading face detection…");
    try {
      if (!landmarker) {
        const { FilesetResolver, FaceLandmarker } = await import("@mediapipe/tasks-vision");
        const files = await FilesetResolver.forVisionTasks("/mediapipe");
        landmarker = await FaceLandmarker.createFromOptions(files, {
          baseOptions: { modelAssetPath: "/models/face_landmarker.task", delegate: "GPU" },
          runningMode: "VIDEO", numFaces: 2, outputFaceBlendshapes: true,
        });
      }
    } catch {
      stop(); reset();
      $("[data-err]").textContent = "Face detection couldn't load in this browser. Try the version without a camera.";
      return;
    }
    if (me !== run) return;

    let holdSince = 0, last = null, eyesClosed = false;
    const loop = () => {
      if (me !== run) return;
      const res = landmarker.detectForVideo(video, performance.now());
      const faces = res.faceLandmarks || [];
      if (!faces.length) { step("find"); cue("Look at the camera"); holdSince = 0; }
      else if (faces.length > 1) { step("find"); cue("Just one person, please"); holdSince = 0; }
      else {
        const xs = faces[0].map((p) => p.x), ys = faces[0].map((p) => p.y);
        const w = Math.max(...xs) - Math.min(...xs);
        const cx = (Math.max(...xs) + Math.min(...xs)) / 2, cy = (Math.max(...ys) + Math.min(...ys)) / 2;
        const cur = ORDER.indexOf($("[data-stage]").dataset.state);
        if (w < 0.28) { step("fit"); cue("Move a little closer"); holdSince = 0; }
        else if (w > 0.62) { step("fit"); cue("Move back a little"); holdSince = 0; }
        else if (Math.abs(cx - 0.5) > 0.12 || Math.abs(cy - 0.48) > 0.14) { step("fit"); cue("Centre your face in the oval"); holdSince = 0; }
        else if (cur < 3) {
          const moved = last ? Math.hypot(cx - last[0], cy - last[1]) : 1;
          if (moved > 0.02) holdSince = performance.now();
          step("hold"); cue("Hold still");
          if (holdSince && performance.now() - holdSince > 900) { step("blink"); cue("Now blink once"); }
        } else {
          const bs = res.faceBlendshapes?.[0]?.categories || [];
          const score = (n) => bs.find((c) => c.categoryName === n)?.score ?? 0;
          const blink = Math.min(score("eyeBlinkLeft"), score("eyeBlinkRight"));
          if (blink > 0.5) eyesClosed = true;
          else if (eyesClosed && blink < 0.2) { success(true); return; }
        }
        last = [cx, cy];
      }
      raf = requestAnimationFrame(loop);
    };
    step("find"); loop();
  }

  $("[data-cam]").addEventListener("click", live);
  $("[data-demo]").addEventListener("click", demo);
  $("[data-again]").addEventListener("click", reset);
  // stop the camera if the person scrolls well away
  new IntersectionObserver((es) => { if (!es[0].isIntersecting && stream) reset(); }).observe(root);
  reset();
</script>

<style is:global>
  .fd .fdev { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); background: var(--ai-surface); color: var(--on-ink); border-radius: 22px; overflow: hidden; box-shadow: 0 40px 80px -40px rgba(0, 0, 0, 0.5); border: 1px solid var(--ai-edge); }
  .fd .fdev__cam { padding: clamp(14px, 2vw, 24px); border-right: 1px solid var(--on-ink-rule); }
  .fd .stage { position: relative; aspect-ratio: 4 / 3; border-radius: 14px; overflow: hidden; background: radial-gradient(circle at 50% 40%, #2c2f5e, #121330); }
  .fd .stage video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transform: scaleX(-1); opacity: 0; }
  .fd .stage.live video { opacity: 1; }
  .fd .oval { position: absolute; inset: 0; width: 100%; height: 100%; }
  .fd .oval__ring { fill: none; stroke: var(--ok-ink); stroke-width: 1.2; stroke-dasharray: 100; stroke-dashoffset: 100; vector-effect: non-scaling-stroke; transition: stroke-dashoffset 0.6s var(--ease); stroke-linecap: round; }
  .fd .stage .oval__ring { stroke-width: 4px; }
  .fd .cue { position: absolute; left: 50%; bottom: 14px; transform: translateX(-50%); margin: 0; padding: 8px 14px; border-radius: 999px; background: var(--paper); color: var(--ink); font-weight: 650; font-size: 15px; white-space: nowrap; }
  .fd .stage[data-state="done"] .cue { background: var(--ok-ink); }
  /* success: the oval closes, then a green badge pops in the middle and its check draws itself */
  .fd .ok { position: absolute; left: 50%; top: 48%; width: clamp(84px, 20%, 128px); aspect-ratio: 1; transform: translate(-50%, -50%); pointer-events: none; z-index: 3; visibility: hidden; }
  .fd .ok svg { position: relative; width: 100%; height: 100%; overflow: visible; }
  .fd .ok__c { fill: var(--ok-ink); transform-origin: 26px 26px; transform: scale(0); }
  .fd .ok__k { fill: none; stroke: var(--ink); stroke-width: 4.5; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 1; stroke-dashoffset: 1; }
  .fd .ok__pulse { position: absolute; inset: 0; border-radius: 50%; border: 2px solid var(--ok-ink); opacity: 0; }
  .fd .stage[data-state="done"] .ok { visibility: visible; }
  .fd .stage[data-state="done"] .oval__ring { stroke-dasharray: none; }
  .fd .stage[data-state="done"] .ok__c { animation: fd-pop 0.5s var(--spring, cubic-bezier(.34,1.56,.64,1)) 0.35s forwards; }
  .fd .stage[data-state="done"] .ok__k { animation: fd-draw 0.4s ease-out 0.75s forwards; }
  .fd .stage[data-state="done"] .ok__pulse { animation: fd-pulse 1.4s ease-out 0.8s 2; }
  .fd .stage[data-state="done"] .sim__face, .fd .stage[data-state="done"] video { opacity: 0.35; transition: opacity 0.4s; }
  @keyframes fd-pop { 0% { transform: scale(0); } 100% { transform: scale(1); } }
  @keyframes fd-draw { to { stroke-dashoffset: 0; } }
  @keyframes fd-pulse { 0% { opacity: 0.7; transform: scale(1); } 100% { opacity: 0; transform: scale(1.9); } }
  @media (prefers-reduced-motion: reduce) {
    .fd .stage[data-state="done"] .ok__c, .fd .stage[data-state="done"] .ok__k { animation-duration: 0.01s; animation-delay: 0s; }
    .fd .stage[data-state="done"] .ok__pulse { animation: none; }
  }
  .fd .start { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; padding: 16px; background: rgba(21, 21, 19, 0.55); }
  .fd .start[hidden] { display: none; }
  .fd .stage:has(.start:not([hidden])) .cue { display: none; }
  .fd .stage:has(.start:not([hidden])) .oval__ring { opacity: 0; }
  .fd .fdev__tags .tag { white-space: normal; }
  .fd .start__note { color: var(--on-ink-2); text-transform: none; letter-spacing: 0; text-align: center; margin: 4px 0 0; }
  .fd .fbtn { display: inline-flex; align-items: center; justify-content: center; min-height: 46px; padding: 0 20px; border-radius: 999px; border: 1.5px solid var(--on-ink-2); background: transparent; color: var(--on-ink); font-weight: 650; cursor: pointer; }
  .fd .fbtn--go { background: var(--tomato); border-color: var(--tomato); color: #fff; }

  .fd .sim { position: absolute; inset: 0; display: none; place-items: center; }
  .fd .stage.demo .sim { display: grid; }
  .fd .sim__face { position: relative; width: 34%; aspect-ratio: 3 / 4; border-radius: 46% 46% 42% 42%; background: #8c8679; transform: translate(14%, 10%) scale(0.75); transition: transform 0.9s var(--ease); }
  .fd .stage[data-state="fit"] .sim__face { transform: translate(6%, 4%) scale(0.9); }
  .fd .stage[data-state="hold"] .sim__face, .fd .stage[data-state="blink"] .sim__face, .fd .stage[data-state="done"] .sim__face { transform: translate(0, -4%) scale(1); }
  .fd .sim__face i { position: absolute; top: 40%; left: 30%; width: 10%; aspect-ratio: 1; border-radius: 50%; background: var(--ink); transition: transform 0.12s; }
  .fd .sim__face i + i { left: auto; right: 30%; }
  .fd .sim__face b { position: absolute; bottom: 22%; left: 38%; width: 24%; height: 4%; border-radius: 4px; background: var(--ink); opacity: 0.6; }
  .fd .stage.blinked .sim__face i { transform: scaleY(0.1); }

  .fd .fdev__side { padding: clamp(18px, 2.4vw, 30px); display: flex; flex-direction: column; gap: 18px; }
  .fd .fdev__tags { display: flex; flex-wrap: wrap; gap: 8px; }
  .fd .fsteps { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .fd .fsteps li { display: flex; gap: 14px; align-items: center; padding: 11px 14px; border-radius: 10px; border: 1px solid var(--on-ink-rule); color: var(--on-ink-2); transition: all 0.3s; }
  .fd .fsteps li .mono { color: inherit; }
  .fd .fsteps li.on { color: var(--on-ink); border-color: var(--on-ink-2); background: var(--ink-3); }
  .fd .fsteps li.done { color: var(--ok-ink); border-color: transparent; }
  .fd .fsteps li.done::after { content: "✓"; margin-left: auto; }
  .fd .after { display: grid; gap: 10px; animation: td-in 0.5s var(--ease) both; }
  .fd .after[hidden] { display: none; }
  .fd .after .mono { color: var(--on-ink-2); }
  .fd .checkin { display: grid; gap: 2px; padding: 14px; border-radius: 12px; background: var(--ink-3); border-left: 3px solid var(--ok-ink); }
  .fd .checkin span { color: var(--on-ink-2); font-size: 14.5px; }
  .fd .small { font-size: 13px; color: var(--on-ink-2); margin: 0; }
  .fd .after .fbtn { justify-self: start; }

  .fd .notes { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(16px, 2.4vw, 32px); margin-top: clamp(28px, 4vw, 48px); }
  .fd .nt { border-top: 1.5px solid var(--ink); padding-top: 12px; }
  .fd .nt .hand { color: var(--fg); }
  .fd .nt p { margin: 6px 0 0; color: var(--fg-2); font-size: 15.5px; }

  @media (max-width: 900px) {
    .fd .fdev { grid-template-columns: minmax(0, 1fr); }
    .fd .fdev__cam { border-right: 0; border-bottom: 1px solid var(--on-ink-rule); }
    .fd .stage { aspect-ratio: 1 / 1; }
    .fd .notes { grid-template-columns: minmax(0, 1fr); }
  }
</style>
