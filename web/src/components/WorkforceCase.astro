---
// Flagship case study: Zaper's onsite workforce app, as Labeeb describes it.
const nodes = [
  {
    id: "checkin", k: "Check in & check out",
    worker: "Checks in and out with their face, on site.",
    sys: "Matches the registered face and checks the site's GPS geofence.", ai: true,
    design: "Guided registration, clear feedback when a match fails, and a manual fallback for supervisors.",
  },
  {
    id: "day", k: "Day stats",
    worker: "Sees check-in, check-out, total, OT and break hours.",
    sys: "Works the hours out, so nobody adds them up by hand.",
    design: "One screen with only the numbers that matter, readable at a glance.",
  },
  {
    id: "project", k: "Project tracking",
    worker: "Their hours are tied to that day's project.",
    sys: "Records the project with each check-in, so time lands on the right job.",
    design: "The project shown at check-in, so mistakes surface that day, not at month end.",
  },
  {
    id: "timesheet", k: "Timesheets & payroll",
    worker: "Gets a monthly timesheet and sees what their pay is based on.",
    sys: "Rolls daily records into a timesheet that feeds payroll.",
    design: "A timesheet they can check line by line, to cut payday disputes.",
  },
  {
    id: "leave", k: "Leave requests",
    worker: "Applies for leave by voice, in their own language.",
    sys: "Turns the request into a leave application and sends it for approval.", ai: true,
    design: "A simple flow with a clear status, so nobody chases a supervisor for an answer.",
  },
];
---
<section class="sec wf" id="workforce" aria-labelledby="wf-h">
  <div class="wrap">
    <div class="sec__head">
      <div class="sec__label reveal"><span class="sec-num">03</span><span class="mono">Time &amp; attendance</span></div>
      <div class="sec__title reveal">
        <h2 id="wf-h" class="h-lg">Check in with your face. The rest adds up.</h2>
        <p class="lede">Day stats, project hours, timesheets, payroll and leave all follow from one check-in. Pick a part to see it.</p>
      </div>
    </div>

    <div class="map reveal" data-wf>
      <div class="map__nodes" role="tablist" aria-label="Parts of the app">
        {nodes.map((n, i) => (
          <button role="tab" class="node" id={`wf-t-${n.id}`} aria-controls={`wf-p-${n.id}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1} data-node={n.id}>
            <span class="mono">0{i + 1}</span>{n.k}{n.ai && <em class="mono node__ai">AI</em>}
          </button>
        ))}
      </div>
      <div class="map__panels">
        {nodes.map((n, i) => (
          <div class="panel" role="tabpanel" id={`wf-p-${n.id}`} aria-labelledby={`wf-t-${n.id}`} hidden={i !== 0}>
            <div class={`viz viz--${n.id}`} aria-hidden={n.id === "checkin" ? undefined : "true"}>
              <span class={`viz__tag mono${n.id === "checkin" ? " viz__tag--sim" : ""}`}>{n.id === "checkin" ? "Simulated · try it" : "Illustration"}</span>
              {n.id === "checkin" && (
                <div class="ci" data-ci data-state="idle">
                  <div class="ci__geo" aria-hidden="true"><span class="ci__ring"></span><span class="ci__pin"></span><span class="mono ci__lbl">On site</span></div>
                  <div class="ci__face" aria-hidden="true"><span class="ci__head"><i></i><i></i></span><span class="ci__scan"></span><span class="ci__flash"></span></div>
                  <div class="ci__side" aria-live="polite">
                    <button type="button" class="ci__btn" data-ci-go><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 8h3l2-3h6l2 3h3v11H4z"/><circle cx="12" cy="13" r="3.5"/></svg>Take selfie to check in</button>
                    <p class="ci__status mono" data-ci-status></p>
                    <div class="ci__res" data-ci-res hidden>
                      <div class="ci__who"><span class="ci__av" aria-hidden="true">AN</span><span><strong>Arjun Nair</strong><em class="mono">Steel fixer · sample</em></span></div>
                      <div class="ci__meta"><span><em class="mono">Checked in</em><b data-ci-time>07:58</b></span><span><em class="mono">Project</em><b>Tower B · MEP works</b></span></div>
                      <span class="ci__okline mono"><b aria-hidden="true">✓</b> Face matched · inside geofence</span>
                      <button type="button" class="ci__again mono" data-ci-again>Retake</button>
                    </div>
                  </div>
                </div>
              )}
              {n.id === "day" && (
                <div class="ds">
                  {[["Check-in", "07:58"], ["Check-out", "17:32"], ["Total", "9h 34m"], ["OT", "1h 34m"], ["Break", "1h 00m"]].map(([k, v], j) => (
                    <div class="ds__c" style={`--d:${j * 0.12}s`}><span class="mono">{k}</span><b>{v}</b></div>
                  ))}
                  <div class="ds__bar"><span class="ds__work"></span><span class="ds__brk"></span><span class="ds__work2"></span><span class="ds__ot"></span></div>
                </div>
              )}
              {n.id === "project" && (
                <div class="pj2">
                  <div class="pj2__card"><span class="mono">Today · checked in 07:58</span><b>Your project</b>
                    <div class="pj2__slot"><span class="pj2__chip">Tower B · MEP works</span></div>
                  </div>
                  <div class="pj2__list"><span>Tower A</span><span class="on">Tower B</span><span>Villa 12</span></div>
                </div>
              )}
              {n.id === "timesheet" && (
                <div class="ts">
                  <div class="ts__grid">{Array.from({ length: 28 }, (_, d) => <i class={[5, 12, 19, 26].includes(d) ? "off" : d === 15 ? "lv" : ""} style={`--d:${d * 0.04}s`}></i>)}</div>
                  <span class="ts__arrow">→</span>
                  <div class="ts__pay">
                    <span class="mono ts__h">October · payroll</span>
                    {[["Days present", "23"], ["Total hours", "216h"], ["OT hours", "18h"], ["Total pay", "AED 2,480"]].map(([k, v], j) => (
                      <div class={`ts__row${j === 3 ? " ts__row--pay" : ""}`} style={`--d:${1.5 + j * 0.25}s`}><span>{k}</span><b>{v}</b></div>
                    ))}
                  </div>
                </div>
              )}
              {n.id === "leave" && (
                <div class="lv">
                  <div class="lv__wave"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
                  <span class="ts__arrow">→</span>
                  <div class="lv__card"><span class="mono">Leave request</span><b>Thu–Fri · 2 days</b>
                    <span class="lv__st"><span class="lv__p mono">Pending</span><span class="lv__a mono">Approved ✓</span></span>
                  </div>
                </div>
              )}
            </div>
            <div class="row"><span class="mono row__k">The worker</span><p>{n.worker}</p></div>
            <div class={`row ${n.ai ? "row--ai" : "row--sys"}`}><span class="mono row__k">{n.ai ? "The AI" : "The system"}</span><p>{n.sys}</p></div>
            <div class="row row--me"><span class="mono row__k">What I designed</span><p>{n.design}</p></div>
          </div>
        ))}
      </div>
    </div>
    <p class="cs-link reveal"><a href="/work/workforce">Workforce Management case study <span aria-hidden="true">→</span></a></p>
  </div>
</section>

<script>
  // Simulated selfie check-in: a sample worker, today's local time, the project from the next tab.
  const ci = document.querySelector<HTMLElement>("[data-ci]");
  if (ci) {
    const go = ci.querySelector<HTMLButtonElement>("[data-ci-go]")!;
    const status = ci.querySelector<HTMLElement>("[data-ci-status]")!;
    const res = ci.querySelector<HTMLElement>("[data-ci-res]")!;
    const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
    let run = 0;
    const set = (st: string) => { ci.dataset.state = st; };
    go.addEventListener("click", async () => {
      const me = ++run;
      go.hidden = true; res.hidden = true; set("snap");
      status.textContent = "Taking selfie…"; await wait(450);
      if (me !== run) return; set("scan");
      status.textContent = "Matching face…"; await wait(1100);
      if (me !== run) return;
      status.textContent = "Checking site location…"; await wait(800);
      if (me !== run) return;
      const now = new Date();
      ci.querySelector("[data-ci-time]")!.textContent = now.toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });
      status.textContent = ""; res.hidden = false; set("done");
    });
    ci.querySelector("[data-ci-again]")!.addEventListener("click", () => { run++; res.hidden = true; status.textContent = ""; go.hidden = false; set("idle"); go.focus(); });
  }

  const root = document.querySelector("[data-wf]");
  const tabs = [...root.querySelectorAll("[data-node]")];
  const pick = (t) => tabs.forEach((x) => {
    const on = x === t;
    x.setAttribute("aria-selected", String(on)); x.tabIndex = on ? 0 : -1;
    document.getElementById(x.getAttribute("aria-controls")).hidden = !on;
  });
  tabs.forEach((t, i) => {
    t.addEventListener("click", () => pick(t));
    t.addEventListener("keydown", (e) => {
      const d = { ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 }[e.key];
      if (!d) return; e.preventDefault();
      const n = tabs[(i + d + tabs.length) % tabs.length]; pick(n); n.focus();
    });
  });
</script>

<style>
  .map { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: clamp(16px, 2.4vw, 32px); align-items: start; }
  .map__nodes { display: grid; gap: 8px; position: relative; }
  .node { display: flex; gap: 14px; align-items: center; text-align: left; padding: 16px 18px; border-radius: 14px; border: 1.5px solid var(--rule-strong); background: var(--card); font-size: 18px; font-weight: 650; letter-spacing: -0.01em; cursor: pointer; transition: transform 0.25s var(--ease), background 0.2s, color 0.2s; }
  .node .mono { color: var(--tomato); }
  .node .node__ai { margin-left: auto; font-style: normal; color: var(--ok); border: 1px solid currentColor; border-radius: 999px; padding: 2px 8px; font-size: 10.5px; }
  .node[aria-selected="true"] .node__ai { color: var(--ok-ink); }
  .node:hover { transform: translateX(4px); }
  .node[aria-selected="true"] { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .map__panels { background: var(--ink); color: var(--on-ink); border-radius: 20px; padding: clamp(18px, 2.4vw, 30px); min-height: 100%; }
  .panel { display: grid; gap: 10px; animation: wf-in 0.4s var(--ease) both; }
  .panel[hidden] { display: none; }
  @keyframes wf-in { from { opacity: 0; transform: translateY(6px); } }
  .row { display: grid; grid-template-columns: 140px minmax(0, 1fr); gap: 16px; padding: 16px; border-radius: 12px; background: var(--ink-3); border-left: 3px solid var(--on-ink-2); }
  .row p { margin: 0; font-size: 17px; line-height: 1.5; }
  .row__k { color: var(--on-ink-2); padding-top: 3px; }
  .row--ai { border-color: var(--ok-ink); } .row--ai .row__k { color: var(--ok-ink); }
  .row--sys { border-color: var(--info-ink); } .row--sys .row__k { color: var(--info-ink); }
  .row--me { border-color: var(--tomato); } .row--me .row__k { color: var(--tomato); }

  .stats { list-style: none; margin: clamp(36px, 5vw, 64px) 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1.5px solid var(--ink); }
  .stats li { padding: 18px 16px 0 0; display: flex; gap: 12px; align-items: baseline; }
  .stats b { font-size: clamp(30px, 3vw, 44px); line-height: 1; color: var(--tomato); }
  .stats span { color: var(--fg); font-size: 17px; font-weight: 600; line-height: 1.35; }
  .wf__src { margin: 18px 0 0; color: var(--fg-3); text-transform: none; letter-spacing: 0; }


  /* per-tab animated illustrations; they replay each time a tab is opened (hidden → shown) */
  .viz { position: relative; height: 170px; border-radius: 14px; background: var(--ink-2); border: 1px solid var(--on-ink-rule); display: grid; place-items: center; overflow: hidden; margin-bottom: 4px; }
  .viz__tag { position: absolute; top: 10px; right: 12px; font-size: 10px; color: var(--on-ink-2); }
  .viz .mono { text-transform: uppercase; letter-spacing: 0.05em; }
  .ci { display: flex; align-items: center; gap: clamp(14px, 3vw, 32px); }
  .ci__geo { position: relative; width: 84px; height: 84px; display: grid; place-items: center; }
  .ci__ring { position: absolute; inset: 0; border-radius: 50%; border: 1.5px dashed var(--info-ink); animation: wf-ring 1.6s var(--ease) both; }
  .ci__pin { width: 12px; height: 12px; border-radius: 50% 50% 50% 0; transform: rotate(-45deg); background: var(--tomato); animation: wf-drop 0.6s 0.3s var(--spring) both; }
  .ci__lbl { position: absolute; bottom: -18px; font-size: 10px; color: var(--info-ink); white-space: nowrap; animation: wf-fade 0.4s 0.8s both; }
  .ci__face { position: relative; flex: none; width: 78px; height: 96px; border-radius: 40px; border: 2px solid var(--on-ink-rule); display: grid; place-items: center; overflow: hidden; transition: border-color 0.3s; }
  .ci__head { width: 44px; height: 54px; border-radius: 45% 45% 42% 42%; background: var(--ink-3); display: flex; justify-content: center; gap: 10px; padding-top: 20px; }
  .ci__head i { width: 5px; height: 5px; border-radius: 50%; background: var(--on-ink); }
  .ci__scan { position: absolute; left: 0; right: 0; top: 0; height: 2px; background: var(--ok-ink); box-shadow: 0 0 12px var(--ok-ink); opacity: 0; }
  .ci__flash { position: absolute; inset: 0; background: #fff; opacity: 0; }
  .ci[data-state="snap"] .ci__flash { animation: wf-flash 0.45s ease-out; }
  .ci[data-state="scan"] .ci__scan { animation: wf-scan 0.95s ease-in-out infinite; }
  .ci[data-state="scan"] .ci__face { border-color: var(--info-ink); }
  .ci[data-state="done"] .ci__face { border-color: var(--ok-ink); }
  .ci[data-state="idle"] .ci__ring, .ci[data-state="snap"] .ci__ring { animation: none; opacity: 0.45; }
  .ci__side { min-width: 0; display: flex; flex-direction: column; align-items: flex-start; gap: 8px; }
  .ci__btn { display: inline-flex; align-items: center; gap: 8px; padding: 11px 16px; border-radius: 999px; border: 0; background: var(--tomato); color: #fff; font: 600 15px/1 var(--f-sans, inherit); cursor: pointer; transition: transform 0.2s var(--ease); }
  .ci__btn[hidden] { display: none; }
  .ci__btn:hover { transform: translateY(-1px); } .ci__btn:focus-visible { outline: 3px solid var(--on-ink); outline-offset: 3px; }
  .ci__status { margin: 0; font-size: 11px; color: var(--info-ink); min-height: 1em; }
  .ci__status:empty { display: none; }
  .ci__res { display: grid; gap: 8px; animation: wf-in 0.45s var(--spring) both; }
  .ci__res[hidden] { display: none; }
  .ci__who { display: flex; align-items: center; gap: 10px; }
  .ci__av { width: 34px; height: 34px; flex: none; border-radius: 50%; display: grid; place-items: center; background: var(--ink-3); color: var(--on-ink); font-size: 12px; font-weight: 700; border: 1.5px solid var(--ok-ink); }
  .ci__who strong { display: block; font-size: 16px; line-height: 1.2; } .ci__who em { font-style: normal; font-size: 10.5px; color: var(--on-ink-2); }
  .ci__meta { display: flex; gap: 18px; flex-wrap: wrap; }
  .ci__meta span { display: grid; gap: 2px; } .ci__meta em { font-style: normal; font-size: 10px; color: var(--on-ink-2); } .ci__meta b { font-size: 14px; font-weight: 600; }
  .ci__okline { font-size: 10.5px; color: var(--ok-ink); } .ci__okline b { font-weight: 700; }
  .ci__again { justify-self: start; background: none; border: 0; padding: 0; color: var(--on-ink-2); font-size: 10.5px; text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }
  .viz__tag--sim { color: var(--mid-ink, #e3b341); }
  .viz--checkin { height: 210px; }
  @keyframes wf-flash { 0% { opacity: 0.9; } 100% { opacity: 0; } }
  @keyframes wf-ring { from { transform: scale(0.3); opacity: 0; } }
  @keyframes wf-drop { from { transform: translateY(-30px) rotate(-45deg); opacity: 0; } }
  @keyframes wf-fade { from { opacity: 0; } }
  @keyframes wf-scan { 0% { top: 0; opacity: 1; } 100% { top: 100%; opacity: 0.2; } }
  @keyframes wf-ok-border { to { border-color: var(--ok-ink); } }
  .ds { width: 90%; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 8px; }
  .ds__c { background: var(--ink-3); border-radius: 10px; padding: 10px; animation: wf-in 0.45s calc(var(--d) + 0.1s) var(--spring) both; }
  .ds__c .mono { display: block; font-size: 9.5px; color: var(--on-ink-2); }
  .ds__c b { font-size: clamp(14px, 1.5vw, 19px); }
  .ds__c:nth-child(4) b { color: var(--mid-ink); }
  .ds__bar { grid-column: 1 / -1; display: flex; height: 10px; border-radius: 5px; overflow: hidden; background: var(--ink-3); }
  .ds__bar span { height: 100%; transform-origin: left; animation: wf-grow 0.5s var(--ease) both; }
  .ds__work { width: 42%; background: var(--ok-ink); animation-delay: 0.7s !important; }
  .ds__brk { width: 10%; background: var(--on-ink-2); animation-delay: 1.1s !important; }
  .ds__work2 { width: 32%; background: var(--ok-ink); animation-delay: 1.4s !important; }
  .ds__ot { width: 16%; background: var(--mid-ink); animation-delay: 1.8s !important; }
  @keyframes wf-grow { from { transform: scaleX(0); } }
  .pj2 { display: flex; align-items: center; gap: 24px; }
  .pj2__card { background: var(--ink-3); border-radius: 12px; padding: 14px 16px; min-width: 200px; }
  .pj2__card .mono { display: block; font-size: 10px; color: var(--on-ink-2); }
  .pj2__card b { display: block; margin: 6px 0 8px; }
  .pj2__slot { height: 30px; border: 1.5px dashed var(--on-ink-rule); border-radius: 999px; display: flex; align-items: center; padding: 2px; }
  .pj2__chip { padding: 4px 12px; border-radius: 999px; background: var(--tomato); color: #fff; font-size: 13px; font-weight: 600; animation: wf-chip 0.6s 1.3s var(--spring) both; }
  .pj2__list { display: grid; gap: 6px; }
  .pj2__list span { padding: 6px 12px; border-radius: 8px; border: 1px solid var(--on-ink-rule); font-size: 13px; color: var(--on-ink-2); animation: wf-in 0.35s var(--spring) both; }
  .pj2__list span:nth-child(2) { animation-delay: 0.1s; } .pj2__list span:nth-child(3) { animation-delay: 0.2s; }
  .pj2__list .on { animation: wf-in 0.35s 0.1s var(--spring) both, wf-pick 0.3s 0.8s both; }
  @keyframes wf-pick { to { border-color: var(--tomato); color: var(--on-ink); } }
  @keyframes wf-chip { from { opacity: 0; transform: translateX(80px) scale(0.8); } }
  .ts { display: flex; align-items: center; gap: 18px; }
  .ts__grid { display: grid; grid-template-columns: repeat(7, 14px); gap: 5px; }
  .viz--timesheet { height: 210px; }
  .ts__grid i { width: 14px; height: 14px; border-radius: 3px; background: var(--ok-ink); animation: wf-in 0.25s var(--d) both; }
  .ts__grid i.off { background: var(--ink-3); } .ts__grid i.lv { background: var(--info-ink); }
  .ts__arrow { color: var(--tomato); font-size: 22px; animation: wf-fade 0.3s 1.2s both; }
  .ts__pay { background: var(--ink-3); border-radius: 12px; padding: 14px 16px; animation: wf-in 0.5s 1.4s var(--spring) both; }
  .ts__pay { min-width: 210px; padding: 12px 14px; }
  .ts__pay .ts__h { display: block; font-size: 10px; color: var(--ok-ink); margin-bottom: 6px; }
  .ts__row { display: flex; justify-content: space-between; gap: 16px; padding: 4px 0; font-size: 13px; color: var(--on-ink-2); border-top: 1px solid var(--on-ink-rule); animation: wf-in 0.4s var(--d) var(--spring) both; }
  .ts__row b { color: var(--on-ink); font-size: 14px; }
  .ts__row--pay b { color: var(--ok-ink); font-size: 16px; }
  .lv { display: flex; align-items: center; gap: 18px; }
  .lv__wave { display: flex; gap: 4px; align-items: center; height: 44px; }
  .lv__wave i { width: 5px; height: 30%; border-radius: 3px; background: var(--on-ink-2); animation: wf-talk 0.5s ease-in-out 3 alternate both; }
  .lv__wave i:nth-child(2n) { animation-delay: 0.15s; } .lv__wave i:nth-child(3n) { animation-delay: 0.3s; }
  @keyframes wf-talk { to { height: 100%; background: var(--ok-ink); } }
  .lv__card { background: var(--ink-3); border-radius: 12px; padding: 14px 16px; min-width: 170px; animation: wf-in 0.5s 1.4s var(--spring) both; }
  .lv__card > .mono { display: block; font-size: 10px; color: var(--on-ink-2); }
  .lv__card b { display: block; margin: 4px 0 8px; }
  .lv__st { position: relative; display: block; height: 22px; }
  .lv__st span { position: absolute; left: 0; font-size: 10.5px; padding: 3px 8px; border-radius: 999px; }
  .lv__st .lv__p { border: 1px solid var(--mid-ink); color: var(--mid-ink); animation: wf-out 0.3s 2.6s both; }
  .lv__st .lv__a { background: var(--ok-ink); color: var(--ink); font-weight: 600; animation: wf-in 0.4s 2.7s var(--spring) both; }
  @keyframes wf-out { to { opacity: 0; transform: translateY(-6px); } }
  @keyframes wf-in { from { opacity: 0; transform: translateY(8px) scale(0.96); } }
  @media (max-width: 560px) {
    .viz { height: 200px; }
    .ds { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .ci__geo { display: none; }
    .ci { max-width: calc(100% - 28px); gap: 14px; }
    .ci__face { flex: none; }
    .viz--checkin { height: auto; min-height: 220px; padding: 40px 16px 18px; }
    .viz--checkin .ci { max-width: 100%; }
    .ci[data-state="done"] { width: 100%; }
    .ci[data-state="done"] .ci__face { display: none; }
    .ci__btn { font-size: 14px; padding: 10px 14px; }
    .pj2__list { display: none; }
