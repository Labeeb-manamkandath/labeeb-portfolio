---
import { RESUME } from "../data/profile.js";
---
<section class="hero" id="intro" aria-labelledby="hero-h">
  <div class="wrap">
    <p class="hero__meta mono reveal">
      <span>Labeeb Manamkandath</span>
      <span>UX UI (Product) Designer · UX of AI · AI Experiences</span>
      <span>Dubai, UAE</span>
    </p>

    <div class="hero__grid">
      <div class="hero__copy">
        <h1 id="hero-h" class="h-xl reveal">
          I design AI that people <span class="hl">trust</span> and actually use.
        </h1>
        <p class="lede reveal">
          For the past two years I've designed an AI-powered workforce platform for construction and facility management
          teams. Whatever the sector, my job is the same. Take what the model can do, and make it simple enough to use and
          clear enough to trust. In total, I have 5+ years of design experience.
        </p>
        <div class="hero__cta reveal">
          <a class="btn" href="/projects">View my work <span class="arr">→</span></a>
          <a class="btn btn--ghost" href={RESUME} target="_blank" rel="noopener">Resume ↗</a>
        </div>
      </div>

      <figure class="hero__photo reveal">
        <img src="/images/portrait-labeeb.webp" alt="Labeeb Manamkandath" width="640" height="800" fetchpriority="high" />
      </figure>
    </div>

    <dl class="snap reveal" aria-label="At a glance">
      <div><dt>Role</dt><dd>UX UI (Product) Designer<small>UX of AI · AI Experiences</small></dd></div>
      <div><dt>Experience</dt><dd>5+ years<small>UX UI and graphic design</small></dd></div>
      <div><dt>Currently</dt><dd>Growgene Tech Solutions<small>Zaper and YellowZap, since 2023</small></dd></div>
      <div><dt>Based in</dt><dd>Dubai, UAE<small>BSc in Information Technology</small></dd></div>
    </dl>
  </div>
</section>

