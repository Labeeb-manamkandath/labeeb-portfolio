  @keyframes hero-signal {
    0% { -webkit-mask-position: -10% 0%; mask-position: -10% 0%; }
    50% { -webkit-mask-position: 55% 45%; mask-position: 55% 45%; }
    100% { -webkit-mask-position: 110% 5%; mask-position: 110% 5%; }
  }
  @media (prefers-reduced-motion: reduce) { .hero::after { animation: none; opacity: 0; } }
  .hero .wrap { position: relative; z-index: 1; }
  .hero__meta { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 6px 24px; color: var(--fg-3); padding-bottom: 14px; margin: 0 0 clamp(28px, 4vw, 56px); border-bottom: 1px solid var(--rule-strong); }
  .hero__meta span:nth-child(2) { color: var(--fg); }
  .hero__grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(24px, 4vw, 64px); align-items: center; }
  .hero__copy .lede { margin: clamp(22px, 2.6vw, 34px) 0 0; max-width: 46ch; }
  .hl { position: relative; white-space: nowrap; }
  .hl::after { content: ""; position: absolute; left: 0; right: 0; bottom: 0.04em; height: 0.12em; background: var(--ok); border-radius: 2px; transform-origin: left; animation: hero-line 0.9s var(--ease) 0.6s both; }
  @keyframes hero-line { from { transform: scaleX(0); } }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }

  .hero__stage { position: relative; padding: 0 0 0 clamp(0px, 4vw, 40px); }
  .panel { position: relative; z-index: 2; background: var(--ai-surface); color: var(--on-ink); border-radius: 18px; padding: 18px; box-shadow: 0 30px 60px -30px rgba(0,0,0,0.45); border: 1px solid var(--ai-edge); }
  .panel__top { display: flex; justify-content: space-between; align-items: center; color: var(--on-ink-2); }
  .wave { display: flex; align-items: center; gap: 3px; height: 38px; margin: 16px 0 8px; }
  .wave i { flex: 1; height: 20%; background: var(--on-ink-2); border-radius: 2px; animation: hero-wv 1.1s ease-in-out infinite alternate; }
  .wave i:nth-child(3n) { animation-delay: -0.3s; } .wave i:nth-child(4n) { animation-delay: -0.7s; } .wave i:nth-child(5n+1) { animation-delay: -0.5s; }
  @keyframes hero-wv { to { height: 100%; } }
  .said { margin: 0 0 14px; font-size: 15px; line-height: 1.45; color: var(--on-ink); opacity: 0; animation: hero-fadeIn 0.6s var(--ease) 0.8s forwards; }
  .out { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .k { display: grid; grid-template-columns: 78px 1fr; gap: 10px; align-items: baseline; padding: 10px 12px; border-radius: 10px; background: var(--ink-3); border-left: 3px solid; opacity: 0; transform: translateY(8px); animation: hero-pop 0.5s var(--ease) forwards; }
  .k b { font-family: var(--f-mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 500; }
  .k span { font-size: 14.5px; }
  .k--ok { border-color: var(--ok-ink); animation-delay: 1.6s; } .k--ok b { color: var(--ok-ink); }
  .k--no { border-color: var(--no-ink); animation-delay: 2s; } .k--no b { color: var(--no-ink); }
  .k--act { border-color: var(--info-ink); animation-delay: 2.4s; } .k--act b { color: var(--info-ink); }
  .panel__foot { display: flex; justify-content: space-between; margin-top: 14px; color: var(--on-ink-2); opacity: 0; animation: hero-fadeIn 0.5s 2.9s forwards; }
  .edit { color: var(--on-ink); }
  @keyframes hero-fadeIn { to { opacity: 1; } }
  @keyframes hero-pop { to { opacity: 1; transform: none; } }
