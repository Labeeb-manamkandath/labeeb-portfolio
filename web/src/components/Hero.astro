  @media (prefers-reduced-motion: reduce) { .hero::after { animation: none; opacity: 0; } }
  .hero .wrap { position: relative; z-index: 1; }
  .hero__meta { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 6px 24px; color: var(--fg-3); padding-bottom: 14px; margin: 0 0 clamp(28px, 4vw, 56px); border-bottom: 1px solid var(--rule-strong); }
  .hero__meta span:nth-child(2) { color: var(--fg); }
  .hero__grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(24px, 4vw, 64px); align-items: center; }
  .hero h1 { font-size: clamp(44px, 6vw, 92px); max-width: 13ch; }
  .hero__copy .lede { margin: clamp(22px, 2.6vw, 34px) 0 0; max-width: 46ch; }
  .hl { position: relative; white-space: nowrap; }
  .hl::after { content: ""; position: absolute; left: 0; right: 0; bottom: 0.04em; height: 0.12em; background: var(--ok); border-radius: 2px; transform-origin: left; animation: hero-line 0.9s var(--ease) 0.6s both; }
  @keyframes hero-line { from { transform: scaleX(0); } }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }

  .hero__photo { position: relative; margin: 0 0 0 auto; width: min(100%, 360px); }
  .hero__photo img { display: block; width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border-radius: 20px; transform: rotate(2deg); border: 6px solid var(--card); box-shadow: 0 30px 60px -30px rgba(0,0,0,0.45); }

  /* the recruiter's at-a-glance row */
  .snap { list-style: none; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin: clamp(48px, 6vw, 80px) 0 0; padding: 0; border-top: 1.5px solid var(--ink); }
  .snap > div { padding: 18px 20px 4px 0; display: grid; gap: 6px; align-content: start; }
  .snap > div:not(:first-child) { padding-left: 20px; border-left: 1px solid var(--rule-strong); }
  .snap dt { font-family: var(--f-mono); font-size: 11.5px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--fg-3); }
  .snap dd { margin: 0; font-size: clamp(17px, 1.5vw, 20px); font-weight: 650; letter-spacing: -0.015em; line-height: 1.25; }
  .snap dd small { display: block; font-size: 14px; font-weight: 500; color: var(--fg-2); letter-spacing: 0; margin-top: 2px; }

  @media (max-width: 960px) {
    .hero__grid { grid-template-columns: minmax(0, 1fr); }
    .hero__photo { margin: 8px auto 0 0; width: min(72%, 300px); }
    .snap { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .snap > div:nth-child(odd) { padding-left: 0; border-left: 0; }
    .snap > div:nth-child(n+3) { border-top: 1px solid var(--rule-strong); margin-top: 14px; }
  }
  @media (max-width: 480px) {
    .snap > div { padding-right: 10px; }
    .snap > div:nth-child(even) { padding-left: 14px; }
  }
</style>
