---
interface Props { current?: string }
const { current } = Astro.props;
const links = [
  { href: "/#demos", label: "AI Work", key: "home" },
  { href: "/projects", label: "Projects", key: "projects" },
  { href: "/approach", label: "Approach", key: "approach" },
  { href: "/about", label: "About", key: "about" },
  { href: "#contact", label: "Contact", key: "contact" },
];
---
<header class="hd">
  <div class="wrap hd__in">
    <a class="hd__brand" href="/" aria-label="Labeeb Manamkandath, home">
      <span class="hd__face"><img src="/images/labeeb-face.webp" alt="" width="128" height="128" /></span>
      <span class="hd__name">Labeeb M.</span>
    </a>
    <nav aria-label="Main">
      <ul class="hd__nav">
        {links.map((l) => <li><a href={l.href} aria-current={current === l.key ? "page" : undefined}>{l.label}</a></li>)}
      </ul>
    </nav>
    <a class="hd__cta" href="mailto:labeebmanamkandath@gmail.com">Say hi</a>
  </div>
</header>

<style>
  .hd { position: sticky; top: 0; z-index: 50; background: color-mix(in srgb, var(--paper) 88%, transparent); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border-bottom: 1px solid var(--rule); }
  .hd__in { display: flex; align-items: center; justify-content: space-between; gap: 16px; height: 64px; }
  .hd__brand { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; }
  .hd__face { width: 34px; height: 34px; border-radius: 50%; overflow: hidden; background: var(--mid); border: 1.5px solid var(--ink); }
  .hd__face img { width: 100%; height: 100%; object-fit: cover; }
  .hd__name { white-space: nowrap; font-weight: 700; letter-spacing: -0.02em; font-size: 18px; }
  .hd__nav { display: flex; gap: 4px; list-style: none; margin: 0; padding: 0; }
  .hd__nav a { display: inline-block; padding: 8px 12px; border-radius: 999px; text-decoration: none; font-size: 15px; font-weight: 500; color: var(--fg-2); transition: background 0.2s, color 0.2s; }
  .hd__nav a[aria-current="page"] { color: var(--fg); font-weight: 600; text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 6px; }
  .hd__nav a[aria-current="page"]:hover { background: transparent; }
  .hd__nav a:hover { background: var(--paper-2); color: var(--fg); }
  .hd__cta { font-family: var(--f-mono); font-size: 12px; text-transform: uppercase; letter-spacing: 0.05em; text-decoration: none; border: 1.5px solid var(--ink); padding: 9px 14px; border-radius: 999px; transition: background 0.2s, color 0.2s; }
  .hd__cta:hover { background: var(--ink); color: var(--paper); }
  @media (max-width: 760px) {
    .hd__cta { display: none; }
    .hd__nav li:first-child, .hd__nav li:last-child { display: none; }
    .hd__nav { gap: 0; }
    .hd__nav a { padding: 7px 9px; font-size: 14px; }
  }
</style>
