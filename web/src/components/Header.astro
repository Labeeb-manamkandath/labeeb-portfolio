---
interface Props { current?: string }
const { current } = Astro.props;
const links = [
  { href: "/#demos", label: "My AI Works", key: "home" },
  { href: "/projects", label: "Projects", key: "projects" },
  { href: "/approach", label: "Approach", key: "approach" },
  { href: "/about", label: "About", key: "about" },
  { href: "#contact", label: "Contact", key: "contact" },
];
---
<header class="hd">
  <div class="wrap hd__in">
    <a class="hd__brand" href="/" aria-label="Labeeb Manamkandath, home">
      <span class="hd__name">Labeeb M.</span>
    </a>
    <button class="hd__menu" type="button" aria-expanded="false" aria-controls="hd-nav" data-hd-menu>
      <span class="hd__bars" aria-hidden="true"><i></i><i></i></span><span data-hd-label>Menu</span>
    </button>
    <nav aria-label="Main" id="hd-nav">
      <ul class="hd__nav">
        {links.map((l) => <li><a href={l.href} aria-current={current === l.key ? "page" : undefined}>{l.label}</a></li>)}
      </ul>
    </nav>
    <a class="hd__cta" href="mailto:labeebmanamkandath@gmail.com">Say hi</a>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>("[data-hd-menu]");
  const hd = document.querySelector<HTMLElement>(".hd");
  if (btn && hd) {
    const label = btn.querySelector("[data-hd-label]")!;
    const set = (open: boolean) => {
      hd.classList.toggle("is-open", open);
      btn.setAttribute("aria-expanded", String(open));
      label.textContent = open ? "Close" : "Menu";
    };
    btn.addEventListener("click", () => set(!hd.classList.contains("is-open")));
    hd.querySelectorAll("nav a").forEach((a) => a.addEventListener("click", () => set(false)));
    document.addEventListener("keydown", (e) => { if (e.key === "Escape") set(false); });
    matchMedia("(min-width: 761px)").addEventListener("change", (m) => { if (m.matches) set(false); });
  }
</script>

<style>
  .hd { position: sticky; top: 0; z-index: 50; background: color-mix(in srgb, var(--paper) 88%, transparent); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border-bottom: 1px solid var(--rule); }
  .hd__in { display: flex; align-items: center; justify-content: space-between; gap: 16px; height: 64px; }
  .hd__brand { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; }
  .hd__name { white-space: nowrap; font-weight: 700; letter-spacing: -0.02em; font-size: 18px; }
  .hd__nav { display: flex; gap: 4px; list-style: none; margin: 0; padding: 0; }
  .hd__nav a { display: inline-block; padding: 8px 12px; border-radius: 999px; text-decoration: none; font-size: 15px; font-weight: 500; color: var(--fg-2); transition: background 0.2s, color 0.2s; }
  .hd__nav a[aria-current="page"] { color: var(--fg); font-weight: 600; text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 6px; }
  .hd__nav a[aria-current="page"]:hover { background: transparent; }
  .hd__nav a:hover { background: var(--paper-2); color: var(--fg); }
  .hd__cta { font-family: var(--f-mono); font-size: 12px; text-transform: uppercase; letter-spacing: 0.05em; text-decoration: none; border: 1.5px solid var(--ink); padding: 9px 14px; border-radius: 999px; transition: background 0.2s, color 0.2s; }
  .hd__cta:hover { background: var(--ink); color: var(--paper); }
  .hd__menu { display: none; }
  @media (max-width: 760px) {
    .hd__cta { display: none; }
    .hd__menu { display: inline-flex; align-items: center; gap: 10px; padding: 9px 14px; border: 1.5px solid var(--ink); border-radius: 999px; background: transparent; font-family: var(--f-mono); font-size: 12px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--fg); cursor: pointer; }
    .hd__bars { position: relative; width: 16px; height: 10px; }
    .hd__bars i { position: absolute; left: 0; right: 0; height: 1.5px; background: currentColor; border-radius: 2px; transition: transform 0.3s var(--ease), top 0.3s var(--ease); }
    .hd__bars i:first-child { top: 1px; } .hd__bars i:last-child { top: 7.5px; }
    .hd.is-open .hd__bars i:first-child { top: 4.25px; transform: rotate(45deg); }
    .hd.is-open .hd__bars i:last-child { top: 4.25px; transform: rotate(-45deg); }
    .hd.is-open .hd__menu { background: var(--ink); color: var(--paper); }
    .hd nav { position: absolute; left: 0; right: 0; top: 100%; background: var(--paper); border-bottom: 1px solid var(--rule-strong); box-shadow: 0 24px 40px -24px rgba(0,0,0,0.25); padding: 8px 16px 16px; opacity: 0; visibility: hidden; transform: translateY(-8px); transition: opacity 0.25s var(--ease), transform 0.25s var(--ease), visibility 0s 0.25s; }
    .hd.is-open nav { opacity: 1; visibility: visible; transform: none; transition: opacity 0.25s var(--ease), transform 0.25s var(--ease); }
    .hd__nav { flex-direction: column; gap: 0; }
    .hd__nav li + li { border-top: 1px solid var(--rule); }
    .hd__nav a { display: block; padding: 14px 4px; border-radius: 0; font-size: 22px; font-weight: 650; letter-spacing: -0.01em; color: var(--fg); }
    .hd__nav a:hover { background: transparent; }
    .hd__nav a[aria-current="page"] { text-underline-offset: 8px; }
  }
</style>
